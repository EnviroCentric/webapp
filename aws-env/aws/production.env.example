# Copy to production.env only on the EC2 host. This file is gitignored.
APP_NAME=enviro-centric
AWS_REGION=us-west-2
API_DOMAIN=api.example.com
WEBSITE_ORIGIN=https://example.com

POSTGRES_USER=enviro_app
POSTGRES_PASSWORD=GENERATE_AND_STORE_IN_SSM
POSTGRES_DB=enviro_production
DATABASE_URL=postgresql://enviro_app:URL_ENCODED_PASSWORD@db:5432/enviro_production

JWT_SECRET_KEY=GENERATE_AND_STORE_IN_SSM
JWT_REFRESH_SECRET_KEY=GENERATE_AND_STORE_IN_SSM
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_MINUTES=43200
ADMIN_CREATION_SECRET=GENERATE_AND_STORE_IN_SSM
ALLOWED_ORIGINS=["https://example.com"]
BACKEND_PORT=8000
GOOGLE_MAPS_API_KEY=SERVER_RESTRICTED_KEY

REPORTS_BUCKET=FROM_CDK_OUTPUT
BACKUPS_BUCKET=FROM_CDK_OUTPUT
BACKEND_IMAGE=FROM_ECR_OUTPUT:latest

# Frontend build-time values (do not expose the server key in Vite)
VITE_API_URL=https://api.example.com
VITE_GOOGLE_PLACES_API_KEY=BROWSER_RESTRICTED_KEY
